OPENAI_API_KEY=your_api_key_here
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_MODEL=llama3.1:8b
# Model used by scripts/embeddings_demo.py (any OpenAI-compatible embeddings model).
# Ollama: nomic-embed-text | OpenAI: text-embedding-3-small
EMBEDDING_MODEL=nomic-embed-text
# OCR is enabled for PDF pages without a text layer. Requires Tesseract on PATH.
OCR_ENABLED=1
TESSERACT_CMD=tesseract
OCR_LANG=eng
OCR_SCALE=2